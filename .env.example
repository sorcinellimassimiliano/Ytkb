# --- Postgres ---
POSTGRES_USER=ytkb
POSTGRES_PASSWORD=ytkb
POSTGRES_DB=ytkb
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://ytkb:ytkb@localhost:5432/ytkb

# --- Embeddings (default: offline fake, CPU-only) ---
EMBEDDING_PROVIDER=fake        # fake | openai | voyage | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536             # fixed at migration 0001
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_EXTRACTION_MODEL=claude-haiku-4-5-20251001
LLM_MERGE_MODEL=claude-sonnet-5
LLM_CHAT_MODEL=claude-sonnet-5

# --- Features ---
CHAT_ENABLED=false

# --- Ingestion ---
TRANSCRIPT_LANGUAGES=["it","en"]
YT_DLP_COOKIES_FILE=
YT_DLP_PROXY=
SCHEDULER_ENABLED=true
CHANNEL_SCAN_CRON=0 3 * * *

# --- ASR fallback ---
ASR_PROVIDER=none              # none | faster_whisper | assemblyai | openai
ASR_WHISPER_MODEL=small
ASR_MAX_DURATION_S=1800

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE=http://localhost:8000
